void roadStroke(MapPoint a,MapPoint b,float radius,uint16_t color){int x0=max(135,(int)floor(min(a.x,b.x)-radius-1)),x1=min(306,(int)ceil(max(a.x,b.x)+radius+1)),y0=max(36,(int)floor(min(a.y,b.y)-radius-1)),y1=min(173,(int)ceil(max(a.y,b.y)+radius+1));float vx=b.x-a.x,vy=b.y-a.y,len=vx*vx+vy*vy;for(int y=y0;y<=y1;y++)for(int x=x0;x<=x1;x++){float t=len>0?constrain(((x-a.x)*vx+(y-a.y)*vy)/len,0.0f,1.0f):0,dist=hypotf(x-a.x-vx*t,y-a.y-vy*t);int alpha=constrain((int)roundf((radius+.5f-dist)*15),0,15);if(alpha)lcd.drawPixel(x,y,blend565(color,lcd.pixelColor(x,y),alpha));}}
String mapLabel(const char*raw){String name=raw;int p=name.indexOf('(');if(p>=0)name=name.substring(0,p);name.trim();if(textWidth(name.c_str(),12)<=84)return name;String out;const char*c=name.c_str();while(*c){const char*start=c;nextCode(c);String part;while(start<c)part+=*start++;if(textWidth((out+part+"…").c_str(),12)>84)break;out+=part;}return out+"…";}
void drawDownloadedMap(){markerPainted=false;mapActualRoad=false;lcd.fillRoundRect(134,35,174,140,10,MAP);for(int i=1;i<activeRoad.count;i++)roadStroke(activeRoad.points[i-1],activeRoad.points[i],4,0xCE35);for(int i=1;i<activeRoad.count;i++)roadStroke(activeRoad.points[i-1],activeRoad.points[i],2.7,0xFFDD);
 struct Box{int x,y,w,h;};Box boxes[3];String names[3];int used=0;auto overlaps=[](Box a,Box b){return a.x<b.x+b.w+3&&a.x+a.w+3>b.x&&a.y<b.y+b.h+3&&a.y+a.h+3>b.y;};
 for(int i=0;i<cfg.count;i++){mapX[i]=activeRoad.stops[i].x;mapY[i]=activeRoad.stops[i].y;names[i]=mapLabel(cfg.stops[i].name);}
 for(int k=cfg.count-1;k>=0;k--){int w=textWidth(names[k].c_str(),12);Box best={140,42+k*38,w,12};float bestScore=1e9;for(int y=42;y<=157;y+=14)for(int side=0;side<2;side++){int x=side?mapX[k]-w-15:mapX[k]+15;x=constrain(x,139,305-w);Box b={x,y,w,12};bool ok=true;for(int j=k+1;j<cfg.count;j++)if(overlaps(b,boxes[j]))ok=false;for(int j=0;j<cfg.count;j++)if(mapX[j]>=b.x-7&&mapX[j]<=b.x+b.w+7&&mapY[j]>=b.y-7&&mapY[j]<=b.y+b.h+7)ok=false;if(overlaps(b,Box{285,142,19,28}))ok=false;float dx=mapX[k]-constrain(mapX[k],b.x,b.x+b.w),dy=mapY[k]-(b.y+6),score=dx*dx+dy*dy;if(ok&&score<bestScore){best=b;bestScore=score;}}boxes[k]=best;used++;}
 for(int i=0;i<cfg.count;i++){auto b=boxes[i];int xx=constrain(mapX[i],b.x,b.x+b.w),yy=constrain(mapY[i],b.y,b.y+b.h);if(hypotf(xx-mapX[i],yy-mapY[i])>21)lcd.drawLine(mapX[i],mapY[i],xx,yy,0xADB4);lcd.fillCircle(mapX[i],mapY[i],i==cfg.count-1?5:3,i==cfg.count-1?RED:INK);}
 textBG=MAP;for(int i=0;i<cfg.count;i++)label(boxes[i].x,boxes[i].y,names[i].c_str(),12,INK,84);label(289,146,"北",12);label(289,158,"↑",12);textBG=BG;lcd.fillRect(134,175,174,27,BG);label(136,185,"道路圖 · ETA 估算",12);
