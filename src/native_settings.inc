String nativeStopLabel(const char*id){uint64_t key=strtoull(id,nullptr,16);int l=0,r=stopLabelCount-1;while(l<=r){int m=(l+r)/2;uint64_t value;memcpy_P(&value,&stopLabels[m].id,sizeof(value));if(value==key){uint32_t off=pgm_read_dword(&stopLabels[m].offset);return String((const char*)stopLabelText+off);}if(value<key)l=m+1;else r=m-1;}return String(id);}
String shortStop(String name){int p=name.indexOf('(');if(p>=0)name=name.substring(0,p);name.trim();return name;}
// Small candidate index + live per-variant validation. New route numbers fall
// back to both regular directions; rebuild the index to discover new variants.
bool searchNativeRoutes(const char*route){nativeVariantCount=0;RouteCandidate candidates[32];int count=0;for(int i=0;i<routeCandidateCount;i++){RouteCandidate c;memcpy_P(&c,routeCandidates+i,sizeof(c));if(strcmp(c.route,route))continue;if(count>=32)return false;candidates[count++]=c;}
 if(!count){strlcpy(candidates[0].route,route,7);candidates[0].bound='O';candidates[0].service=1;candidates[1]=candidates[0];candidates[1].bound='I';count=2;}
 bool reached=false;for(int i=0;i<count;i++){auto&c=candidates[i];DynamicJsonDocument d(2048);String dir=c.bound=='O'?"outbound":"inbound";if(!api("route/"+String(route)+"/"+dir+"/"+String(c.service),d))continue;reached=true;JsonObject row=d["data"].as<JsonObject>();if(row.isNull()||String(row["route"]|"")!=route||String(row["bound"]|"")!=String(c.bound)||atoi(row["service_type"]|"0")!=c.service)continue;auto&v=nativeVariants[nativeVariantCount++];v.bound=c.bound;v.service=c.service;strlcpy(v.destination,row["dest_tc"]|"",100);delay(1);}return reached;
}
void nativeWorker(void*){NativeJob job;for(;;){if(xQueueReceive(nativeJobs,&job,portMAX_DELAY)!=pdTRUE)continue;NativeDone done={job.kind,0,job.token};
 if(job.kind==1){if(!searchNativeRoutes(job.route))done.error=1;else if(!nativeVariantCount)done.error=2;}
 else if(job.kind==2){DynamicJsonDocument d(24576);String dir=job.variant.bound=='O'?"outbound":"inbound";nativeStopCount=0;if(!api("route-stop/"+String(job.route)+"/"+dir+"/"+job.variant.service,d))done.error=1;else{for(JsonObject row:d["data"].as<JsonArray>()){if(nativeStopCount>=256){done.error=3;break;}const char*id=row["stop"]|"";int seq=atoi(row["seq"]|"0");if(!validID(id)||seq<1){done.error=1;break;}auto&s=nativeStops[nativeStopCount++];strlcpy(s.id,id,17);s.seq=seq;}std::sort(nativeStops,nativeStops+nativeStopCount,[](const NativeStopRef&a,const NativeStopRef&b){return a.seq<b.seq;});if(!nativeStopCount)done.error=2;}}
 else if(job.kind==3){nativeSelectionCount=0;int first=max(0,job.index-2);for(int i=first;i<=job.index;i++){DynamicJsonDocument d(2048);if(!api("stop/"+String(nativeStops[i].id),d)){done.error=1;break;}JsonObject v=d["data"];if(String(v["stop"]|"")!=nativeStops[i].id){done.error=1;break;}auto&s=nativeSelection[nativeSelectionCount++];strlcpy(s.id,nativeStops[i].id,17);strlcpy(s.name,v["name_tc"]|"",100);s.lat=atof(v["lat"]|"0");s.lng=atof(v["long"]|"0");s.seq=nativeStops[i].seq;}}
 xQueueSend(nativeDone,&done,portMAX_DELAY);}}
void nativeInit(){nativeJobs=xQueueCreate(1,sizeof(NativeJob));nativeDone=xQueueCreate(1,sizeof(NativeDone));xTaskCreatePinnedToCore(nativeWorker,"settings",10240,nullptr,1,nullptr,0);}
void openNative(){draft=cfg;nativeBaseGen=cfg.gen;nativePage=NS_HOME;nativeLetters=false;letterPage=0;nativeSaved=false;nativeMessage="";strlcpy(nativeRoute,cfg.route,8);settings=true;needsDraw=true;}
void startNativeJob(int kind,int index=0){if(nativeBusy||nativePending){nativeMessage="上一個查詢尚未完成，請稍候";needsDraw=true;return;}if(WiFi.status()!=WL_CONNECTED||time(nullptr)<1700000000){nativeMessage="請先連 Wi-Fi，等時間同步";needsDraw=true;return;}nativeQueued={};nativeQueued.kind=kind;nativeQueued.index=index;nativeQueued.token=++nativeToken;strlcpy(nativeQueued.route,nativeRoute,8);if(kind>1)nativeQueued.variant=nativeVariants[nativeChoice];nativePending=true;nativePage=NS_WAIT;nativeMessage="正在讀取九巴資料…";needsDraw=true;}
void pollNative(){if(nativePending&&!requestBusy&&!nativeBusy){if(xQueueSend(nativeJobs,&nativeQueued,0)==pdTRUE){nativePending=false;nativeBusy=true;}}NativeDone done;if(xQueueReceive(nativeDone,&done,0)!=pdTRUE)return;nativeBusy=false;if(done.token!=nativeToken)return;nativeOffset=0;if(done.error){nativeMessage=done.error==2?"找不到路線或車站":"未能讀取，請重試";nativePage=NS_KEYS;}else if(done.kind==1){nativePage=NS_VARIANTS;nativeMessage="";}else if(done.kind==2){nativePage=NS_STOPS;nativeMessage="";}else{draft.count=nativeSelectionCount;for(int i=0;i<draft.count;i++)draft.stops[i]=nativeSelection[i];strlcpy(draft.route,nativeRoute,8);draft.bound=nativeVariants[nativeChoice].bound;draft.service=nativeVariants[nativeChoice].service;strlcpy(draft.destination,nativeVariants[nativeChoice].destination,100);draft.seq=draft.stops[draft.count-1].seq;strlcpy(draft.stop,draft.stops[draft.count-1].id,17);nativeSaved=false;nativePage=NS_HOME;nativeMessage="";}needsDraw=true;}
