void saveNative(){if(nativeBaseGen!=cfg.gen){draft=cfg;nativeBaseGen=cfg.gen;nativeMessage="設定已有更新，請再確認";return;}DynamicJsonDocument d(4096);d["route"]=draft.route;d["bound"]=String(draft.bound);d["service"]=draft.service;d["stop"]=draft.stop;d["seq"]=draft.seq;d["destination"]=draft.destination;d["threshold"]=draft.threshold;d["brightness"]=draft.brightness;d["armed"]=draft.armed;JsonArray ss=d.createNestedArray("stops");for(int i=0;i<draft.count;i++){JsonObject s=ss.createNestedObject();s["id"]=draft.stops[i].id;s["name"]=draft.stops[i].name;s["lat"]=draft.stops[i].lat;s["lng"]=draft.stops[i].lng;s["seq"]=draft.stops[i].seq;}if(applyConfig(d,true)){nativeSaved=true;nativeBaseGen=cfg.gen;nativeMessage="";}else nativeMessage="設定未儲存，請再確認";}
