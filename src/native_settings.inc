void nativeTouch(int x,int y){needsDraw=true;
 if(y<38&&x<100){if(nativePage==NS_HOME){settings=false;ledcWrite(0,cfg.brightness);}else if(nativePage==NS_WAIT){nativeToken++;nativePending=false;nativePage=NS_KEYS;}else if(nativePage==NS_STOPS)nativePage=NS_VARIANTS;else if(nativePage==NS_VARIANTS)nativePage=NS_KEYS;else nativePage=NS_HOME;nativeMessage="";return;}
 if(nativePage==NS_WAIT)return;nativeMessage="";
 if(nativePage==NS_HOME){if(y>=201){saveNative();return;}if(y>=47&&y<113){if(x<160){strlcpy(nativeRoute,draft.route,8);nativePage=NS_KEYS;}else nativePage=NS_ALERT;}else if(y>=122&&y<188)nativePage=x<160?NS_LIGHT:NS_WIFI;return;}
 if(nativePage==NS_KEYS){if(y>=202){if(x<100)nativeRoute[0]=0;else if(strlen(nativeRoute))startNativeJob(1);return;}if(y<76||y>=196)return;int row=(y-76)/30;if(!nativeLetters){int col=(x-12)/101;if(x<12||col>2||(x-12)%101>=94)return;int idx=row*3+col;if(idx<9)appendRouteKey(nativeRoute,'1'+idx);else if(idx==9){nativeLetters=true;letterPage=0;}else if(idx==10)appendRouteKey(nativeRoute,'0');else eraseRouteKey(nativeRoute);}else{int col=(x-12)/76;if(x<12||col>3||(x-12)%76>=70)return;int idx=row*4+col;if(idx<12){int letter=letterPage*12+idx;if(letter<26)appendRouteKey(nativeRoute,'A'+letter);}else if(idx==12)nativeLetters=false;else if(idx==13)letterPage=(letterPage+1)%3;else if(idx==14)nativeRoute[0]=0;else eraseRouteKey(nativeRoute);}return;}
 if(nativePage==NS_VARIANTS||nativePage==NS_STOPS){int total=nativePage==NS_VARIANTS?nativeVariantCount:nativeStopCount;if(y>=201){if(x<100)nativeOffset=pagePrevious(nativeOffset);else if(x>=220)nativeOffset=pageNext(nativeOffset,total);return;}if(y<46||y>=190)return;int index=nativeOffset+(y-46)/48;if(index>=total)return;if(nativePage==NS_VARIANTS){nativeChoice=index;startNativeJob(2);}else startNativeJob(3,index);return;}
 if(y>=201){nativePage=NS_HOME;return;}
 if(nativePage==NS_ALERT){if(y>=50&&y<116){if(x<90)draft.threshold=max(1,draft.threshold-1);else if(x>=230)draft.threshold=min(60,draft.threshold+1);}else if(y>=140&&y<=178)draft.armed=!draft.armed;nativeSaved=false;}
 if(nativePage==NS_LIGHT&&y>=120&&y<=168){if(x<100)draft.brightness=max(26,draft.brightness-13);else if(x>220)draft.brightness=min(255,draft.brightness+13);ledcWrite(0,draft.brightness);nativeSaved=false;}
}

// USB-only UI test/control. No save shortcut: use the same hit targets as touch.
void nativeDebug(JsonDocument&d){String action=d["action"]|"status";if(action=="open")openNative();else if(action=="close"){nativeToken++;nativePending=false;settings=false;ledcWrite(0,cfg.brightness);needsDraw=true;}else if(action=="touch"&&settings){int x=d["x"]|-1,y=d["y"]|-1;if(x>=0&&x<320&&y>=0&&y<240)nativeTouch(x,y);}DynamicJsonDocument out(700);out["event"]="settings";out["page"]=(int)nativePage;out["open"]=settings;out["busy"]=nativeBusy||nativePending;out["variants"]=nativeVariantCount;out["stops"]=nativeStopCount;out["offset"]=nativeOffset;out["input"]=nativeRoute;out["draftRoute"]=draft.route;out["draftStop"]=draft.stop;out["saved"]=nativeSaved;out["error"]=nativeMessage;serializeJson(out,Serial);Serial.println();}
